{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "redirects": [
    { "source": "/blog/ptl-vs-ftl-difference", "destination": "/blog/ptl-vs-ftl-when-to-use-each", "permanent": true },
    { "source": "/blog/how-to-ship-steel-india", "destination": "/blog/steel-transport-india-guide", "permanent": true },
    { "source": "/blog/how-to-find-return-load-trucks", "destination": "/blog/how-to-find-return-loads-india", "permanent": true },
    { "source": "/blog/ai-freight-matching", "destination": "/blog/digital-freight-matching-india", "permanent": true },
    { "source": "/blog/digital-load-boards-india", "destination": "/blog/digital-freight-matching-india", "permanent": true },
    { "source": "/blog/digital-freight-marketplace-benefits", "destination": "/blog/digital-freight-matching-india", "permanent": true },
    { "source": "/blog/truck-transport-cost-per-km-india-2026", "destination": "/blog/truck-transport-charges-per-km-india", "permanent": true },
    { "source": "/blog/gst-for-transporters-complete-guide", "destination": "/blog/indian-logistics-eway-bill-gst-2026", "permanent": true },
    { "source": "/blog/monsoon-freight-tips-india", "destination": "/blog/monsoon-logistics-tips", "permanent": true },
    { "source": "/blog/east-india-freight-corridors-guide", "destination": "/blog/east-india-freight-corridors", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.clerk.accounts.dev https://*.clerk.loadsaathi.in https://us.i.posthog.com https://us.posthog.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.cookiehub.eu https://www.clarity.ms https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.cookiehub.eu; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://unpkg.com https://raw.githubusercontent.com https://aejvxilhydyfbwkhjpdt.supabase.co https://cdn.cookiehub.eu https://*.clerk.accounts.dev; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.loadsaathi.in https://aejvxilhydyfbwkhjpdt.supabase.co https://us.i.posthog.com https://us.posthog.com https://router.project-osrm.org https://nominatim.openstreetmap.org https://www.google-analytics.com https://www.clarity.ms https://cdn.cookiehub.eu; frame-src 'self' https://*.clerk.accounts.dev https://*.clerk.loadsaathi.in; worker-src 'self' blob:; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
