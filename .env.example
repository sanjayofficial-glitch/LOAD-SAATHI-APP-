# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# PostHog Analytics (optional — app works without it)
VITE_POSTHOG_API_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-...

# Sentry Error Monitoring (optional — free tier: 5K events/month)
VITE_SENTRY_DSN=https://...

# VAPID Public Key for Web Push notifications (optional)
VITE_VAPID_PUBLIC_KEY=...

# Admin (optional)
VITE_ADMIN_USER_ID=...
VITE_OWNER_WHATSAPP=9999999999

# Gemini (server-side only — handled by Edge Functions, no client key needed)
# GEMINI_API_KEY — set in Supabase dashboard → Edge Functions → Settings
# GROQ_API_KEY — set in Supabase dashboard → Edge Functions → Settings
# OPENROUTER_API_KEY — set in Supabase dashboard → Edge Functions → Settings

# Fish Audio TTS (server-side only — keep off the client; free tier model is s2.1-pro-free)
# Get key at: https://fish.audio (Dashboard → API Keys)
# FISH_API_KEY=your_fish_api_key
# FISH_TTS_ENABLED=true   # kill switch for the /functions/v1/tts edge function
# FISH_REFERENCE_ID=...   # optional custom voice (e.g., cloned Hindi voice) — set
#                         # to a Fish Audio reference id to switch Freddy's voice
# FISH_JWT_SECRET / FISH_EXPECTED_ISSUER / FISH_EXPECTED_AUDIENCE
#   — same values as the FREDDY_* trio (Clerk "supabase" JWT template); if unset,
#     the tts function falls back to FREDDY_*

# IndexNow (Bing + participating search engines)
# INDEXNOW_KEY is the PUBLIC verification key (must be 8–128 hex chars). It also
# lives at https://loadsaathi.in/<key>.txt — public by design.
# INDEXNOW_API_TOKEN is a SECRET bearer token that protects POST /api/indexnow.
INDEXNOW_KEY=
INDEXNOW_API_TOKEN=
