# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin user ID (for admin role access)
VITE_ADMIN_USER_ID=your-admin-user-id

# Owner WhatsApp (for lead-capture FAB + contact form)
VITE_OWNER_WHATSAPP=918328998031

# PostHog Analytics
VITE_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Disha coordinator (opt-in) — "true" shows the "Ask Disha" button inside
# Freddy's speech bubble (signed-in users only). Default is OFF; leave unset
# or "false" to keep Freddy exactly as it is today.
VITE_DISHA_UI=false

# IMPORTANT: For Vercel deployment, add these exact variables (same names)
# to Vercel Dashboard -> Project Settings -> Environment Variables.
# Do NOT rely on a local .env file pushed to the repo — Vercel ignores it.
