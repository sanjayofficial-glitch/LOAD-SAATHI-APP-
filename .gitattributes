# Auto detect text files and perform LF normalization
* text=auto

# Source code - LF line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Windows build scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files - never modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.db binary
*.apk binary
*.aab binary

# Lockfiles
pnpm-lock.yaml text eol=lf
